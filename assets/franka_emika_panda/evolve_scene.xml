<mujoco model="evolve_franka_scene">
  <compiler angle="radian" meshdir="assets" autolimits="true" balanceinertia="true"/>
  <include file="evolve_panda.xml"/>

  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.85 0.85 0.85 1" specular="0.2"/>
    <material name="target_mat" rgba="0.9 0.1 0.1 1" specular="0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Worktable -->
    <body name="table" pos="0.55 0 0.2">
      <geom name="table_top" type="box" size="0.4 0.5 0.2" material="table_mat"/>
    </body>

    <!-- Target manipulation object for Stage 5 Vision & Semantics -->
    <body name="target_obj" pos="0.5 0.1 0.45">
      <freejoint name="target_joint"/>
      <geom name="target_geom" type="box" size="0.025 0.025 0.04" material="target_mat" mass="0.1"/>
      <site name="target_site" pos="0 0 0" size="0.01" rgba="0 1 0 1"/>
    </body>

    <!-- Global Workspace Tracking Camera (Stage 4 & 5) -->
    <camera name="overhead_cam" pos="1.2 0.0 1.2" quat="0.653 0.271 0.271 0.653" fovy="55"/>
  </worldbody>
</mujoco>
